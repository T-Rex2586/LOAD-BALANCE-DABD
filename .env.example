# Database (samakan dengan Database/docker-compose.yaml)
DB_USER=postgres
DB_PASSWORD=password123
DB_NAME=db_kantin

# Port API yang di-publish saat mode dev (docker-compose.dev.yml)
API_PORT=8000

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Kredensial demo (role admin bisa POST/PUT/DELETE, viewer hanya GET)
API_ADMIN_USERNAME=admin
API_ADMIN_PASSWORD=admin123
API_VIEWER_USERNAME=viewer
API_VIEWER_PASSWORD=viewer123
